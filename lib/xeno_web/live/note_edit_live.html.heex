<Layouts.app flash={@flash}>
  <.container max_width={:xl}>
    <.stack gap={:xl}>
      <.stack gap={:s}>
        <.heading level={1}>Edit Note</.heading>
        <p class="text-sm opacity-70">
          Type: {@note.note_type.name} · Directory: {@note.directory.path}
        </p>
      </.stack>

      <.form for={@form} phx-change="validate" phx-submit="save" id="note-edit-form">
        <.stack gap={:l}>
          <.input field={@form[:name]} type="text" label="Name" required />

          <div>
            <label class="block text-sm font-medium mb-2">
              Filename
            </label>
            <div class="px-3 py-2 bg-base-200 rounded-lg font-mono text-sm opacity-70">
              {@note.filename}
            </div>
            <p class="mt-1 text-xs opacity-60">Filename cannot be changed</p>
          </div>

          <div>
            <label class="block text-sm font-medium mb-2">
              Tags
            </label>
            <input
              type="text"
              name="note[tags_string]"
              value={@tags_string}
              placeholder="space separated tags"
              class="input input-bordered w-full"
            />
            <p class="mt-1 text-xs opacity-60">Enter tags separated by spaces</p>
          </div>

          <.input
            field={@form[:text]}
            type="textarea"
            label="Text Content"
            rows="15"
            class="font-mono text-sm"
          />

          <div>
            <label class="block text-sm font-medium mb-2">
              Data (JSON)
            </label>
            <textarea
              name="note[data_string]"
              rows="8"
              class="textarea textarea-bordered w-full font-mono text-sm"
              placeholder="{}"
            >{@data_string}</textarea>
            <p class="mt-1 text-xs opacity-60">Must be valid JSON</p>
          </div>

          <.button_group gap={:m}>
            <button type="submit" class="btn btn-primary">
              Save Changes
            </button>
            <button type="button" phx-click="cancel" class="btn">
              Cancel
            </button>
          </.button_group>
        </.stack>
      </.form>
    </.stack>
  </.container>
</Layouts.app>
