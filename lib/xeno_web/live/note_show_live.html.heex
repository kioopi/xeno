<Layouts.app flash={@flash}>
  <.container max_width={:xl}>
    <.stack gap={:xl}>
      <.page_header
        title={@note.name}
        subtitle={"Type: #{@note.note_type.name} · Directory: #{@note.directory.path} · Version: #{@note.version}"}
      >
        <:actions>
          <.button phx-click="edit" variant={:brand} appearance={:filled}>Edit</.button>
        </:actions>
      </.page_header>

      <.tag_list :if={@note.tags} tags={@note.tags} variant={:primary} />

      <.card :if={@note.html} level={2} title="Content">
        <.prose html={@note.html} />
      </.card>

      <.card :if={@note.data && @note.data != %{}} level={2} title="Data">
        <.code_block content={Jason.encode!(@note.data, pretty: true)} language="json" />
      </.card>

      <div class="text-xs opacity-60">
        <p>Created: {Calendar.strftime(@note.inserted_at, "%Y-%m-%d %H:%M:%S")}</p>
        <p>Updated: {Calendar.strftime(@note.updated_at, "%Y-%m-%d %H:%M:%S")}</p>
      </div>
    </.stack>
  </.container>
</Layouts.app>
