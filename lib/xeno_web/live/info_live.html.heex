<Layouts.app flash={@flash}>
  <.container>
    <.stack gap={:xl}>
      <.heading level={1}>Xeno Installation Information</.heading>

      <%!-- TODO: Replace with <.card> component when ready --%>
      <div class="bg-white shadow rounded-lg p-6">
        <div class="space-y-4">
          <div>
            <dt class="text-sm font-medium text-gray-500 mb-1">Notes Directory</dt>
            <dd class="text-lg text-gray-900 font-mono bg-gray-50 px-3 py-2 rounded">
              {@notes_dir}
            </dd>
          </div>
        </div>
      </div>

      <.grid min_column_size="400px" gap={:l}>
        <.stack gap={:m}>
          <.heading level={2}>Current Implementation (HTML Details)</.heading>
          <Navigation.file_tree directories={@directories} />
        </.stack>

        <.stack gap={:m}>
          <.heading level={2}>WebAwesome Component</.heading>
          <Navigation.webawesome_file_tree directories={@directories} />
        </.stack>
      </.grid>
    </.stack>
  </.container>
</Layouts.app>
