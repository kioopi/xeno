<Layouts.app flash={@flash}>
  <div id="sync-container" phx-hook="FileSystem" class="max-w-6xl mx-auto p-6">
    <h1 class="text-3xl font-bold mb-6">Editor Integration</h1>

    <div class="card bg-base-200 mb-6">
      <div class="card-body">
        <h2 class="card-title">Local Folder Connection</h2>
        <p class="text-sm opacity-70 mb-4">
          Connect a local folder to sync your notes for editing with external editors like VS Code or Vim.
        </p>

        <%= if @directory_connected do %>
          <div class="alert alert-success mb-4">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="stroke-current shrink-0 h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
            <span>
              Connected to folder{if @directory_name, do: ": #{@directory_name}", else: ""}
            </span>
          </div>
          <%!-- FileSystemObserver Status Badge --%>
          <div class="mb-4">
            <%= if @observer_supported do %>
              <div class="flex items-center gap-4">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-sm bg-green-100 text-green-800">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-4 w-4 mr-1"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                    />
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                    />
                  </svg>
                  Auto-sync available
                </span>
                <%= if @watching_enabled do %>
                  <span class="flex items-center text-sm text-green-600 animate-pulse">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-4 w-4 mr-1"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                      />
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                      />
                    </svg>
                    Watching for changes...
                  </span>
                <% end %>
              </div>
            <% else %>
              <span class="inline-flex items-center px-3 py-1 rounded-full text-sm bg-gray-100 text-gray-600">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="h-4 w-4 mr-1"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                  />
                </svg>
                Auto-sync not supported (use manual import)
              </span>
            <% end %>
          </div>

          <div class="flex gap-4">
            <button
              id="export-all-btn"
              phx-click="export_all"
              disabled={@sync_status != :idle}
              class={[
                "btn btn-primary transition-all duration-200",
                @sync_status != :idle && "btn-disabled"
              ]}
            >
              <%= cond do %>
                <% @sync_status == :exporting -> %>
                  <span class="loading loading-spinner loading-sm"></span> Exporting...
                <% match?({:exporting, _, _}, @sync_status) -> %>
                  <% {_, current, total} = @sync_status %>
                  <span class="loading loading-spinner loading-sm"></span>
                  Exporting {current}/{total}
                <% true -> %>
                  Export All Notes
              <% end %>
            </button>

            <button
              id="import-btn"
              phx-click="scan_files"
              disabled={@import_status != :idle}
              class={[
                "btn btn-secondary transition-all duration-200",
                @import_status != :idle && "btn-disabled"
              ]}
            >
              <%= cond do %>
                <% @import_status == :scanning -> %>
                  <span class="loading loading-spinner loading-sm"></span> Scanning...
                <% match?({:importing, _, _}, @import_status) -> %>
                  <% {_, current, total} = @import_status %>
                  <span class="loading loading-spinner loading-sm"></span>
                  Importing {current}/{total}
                <% true -> %>
                  Import Changes
              <% end %>
            </button>
            <%!-- Auto-Sync Toggle Button (only if observer supported) --%>
            <%= if @observer_supported do %>
              <%= if @watching_enabled do %>
                <button
                  id="stop-watching-btn"
                  phx-click="stop_watching"
                  class="btn btn-warning transition-all duration-200"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5 mr-1"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z"
                    />
                  </svg>
                  Pause Auto-Sync
                </button>
              <% else %>
                <button
                  id="start-watching-btn"
                  phx-click="start_watching"
                  class="btn btn-success transition-all duration-200"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5 mr-1"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"
                    />
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                    />
                  </svg>
                  Enable Auto-Sync
                </button>
              <% end %>
            <% end %>

            <button
              id="disconnect-directory-btn"
              phx-click="disconnect_directory"
              class="btn btn-outline transition-all duration-200"
            >
              Disconnect Folder
            </button>
          </div>

          <div class="text-sm opacity-70 mt-4">
            <p><strong>Export:</strong> Save notes from database to local files</p>
            <p><strong>Import:</strong> Load changes from local files back to database</p>
          </div>

          <%= if @last_operation do %>
            <div class="mt-4 text-sm opacity-70 flex items-center gap-2 animate-fade-in">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-4 w-4 text-success animate-scale-in"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                />
              </svg>
              <span>
                Last {if @last_operation.type == :export, do: "export", else: "import"}: {@last_operation.count} note(s)
                <%= if @last_operation.type == :import && @last_operation.failed > 0 do %>
                  ({@last_operation.failed} failed)
                <% end %>
                in
                <%= cond do %>
                  <% @last_operation.duration < 1000 -> %>
                    {@last_operation.duration}ms
                  <% @last_operation.duration < 60_000 -> %>
                    {Float.round(@last_operation.duration / 1000, 1)}s
                  <% true -> %>
                    {div(@last_operation.duration, 60_000)}m {div(
                      rem(@last_operation.duration, 60_000),
                      1000
                    )}s
                <% end %>
                • {Calendar.strftime(@last_operation.timestamp, "%H:%M:%S")}
              </span>
            </div>
          <% end %>
        <% else %>
          <button id="connect-directory-btn" phx-click="connect_directory" class="btn btn-primary">
            Choose Folder
          </button>

          <p class="text-xs opacity-60 mt-4">
            Note: This feature requires Chrome 86+ or Edge 86+
          </p>
        <% end %>
      </div>
    </div>

    <%= if @error do %>
      <div class="alert alert-error mb-6">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="stroke-current shrink-0 h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"
          />
        </svg>
        <span>{@error}</span>
      </div>
    <% end %>

    <%= if @sync_errors do %>
      <div id="error-container" class="space-y-3 mb-6 animate-fade-in">
        <div class="flex items-center justify-between mb-2">
          <h3 class="text-lg font-semibold">
            Sync Errors ({length(@sync_errors)})
          </h3>
          <button
            id="clear-errors-btn"
            phx-click="clear_errors"
            class="btn btn-ghost btn-sm"
          >
            Clear All
          </button>
        </div>

        <div
          :for={{error, idx} <- Enum.with_index(@sync_errors)}
          class="alert shadow-lg transition-all duration-200 hover:shadow-xl"
        >
          <%!-- Icon based on error type --%>
          <%= cond do %>
            <% error["type"] == "id_not_found" -> %>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="stroke-warning shrink-0 h-6 w-6"
                fill="none"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                />
              </svg>
            <% error["type"] == "path_mismatch" -> %>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="stroke-error shrink-0 h-6 w-6"
                fill="none"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"
                />
              </svg>
            <% error["type"] == "validation" -> %>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="stroke-error shrink-0 h-6 w-6"
                fill="none"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"
                />
              </svg>
            <% true -> %>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="stroke-info shrink-0 h-6 w-6"
                fill="none"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                />
              </svg>
          <% end %>

          <div class="flex-1">
            <div class="flex items-center gap-2 mb-1">
              <%!-- Error type badge --%>
              <%= cond do %>
                <% error["type"] == "id_not_found" -> %>
                  <span class="badge badge-warning badge-sm">ID Not Found</span>
                <% error["type"] == "path_mismatch" -> %>
                  <span class="badge badge-error badge-sm">Path Mismatch</span>
                <% error["type"] == "validation" -> %>
                  <span class="badge badge-error badge-sm">Validation Error</span>
                <% true -> %>
                  <span class="badge badge-info badge-sm">Unknown Error</span>
              <% end %>
              <%= if error["note_name"] do %>
                <span class="font-semibold">{error["note_name"]}</span>
              <% end %>
            </div>

            <%= if error["file_path"] do %>
              <code class="text-xs bg-base-200 px-2 py-1 rounded block mb-1">
                {error["file_path"]}
              </code>
            <% end %>

            <p class="text-sm">{error["message"]}</p>

            <%!-- Collapsible details section --%>
            <%= if error["type"] == "id_not_found" && error["suggested_id"] do %>
              <details class="mt-2">
                <summary class="text-xs cursor-pointer opacity-70 hover:opacity-100">
                  Show Details
                </summary>
                <div class="text-xs mt-2 bg-base-200 p-2 rounded">
                  <div>
                    <strong>Provided ID:</strong>
                    <code class="ml-1">{error["provided_id"]}</code>
                  </div>
                  <%= if error["suggested_id"] do %>
                    <div>
                      <strong>Suggested ID:</strong>
                      <code class="ml-1">{error["suggested_id"]}</code>
                    </div>
                  <% end %>
                </div>
              </details>
            <% end %>

            <%= if error["type"] == "path_mismatch" do %>
              <details class="mt-2">
                <summary class="text-xs cursor-pointer opacity-70 hover:opacity-100">
                  Show Details
                </summary>
                <div class="text-xs mt-2 bg-base-200 p-2 rounded space-y-1">
                  <div>
                    <strong>Expected Path:</strong>
                    <code class="ml-1">{error["expected_path"]}</code>
                  </div>
                  <div>
                    <strong>Actual Path:</strong>
                    <code class="ml-1">{error["actual_path"]}</code>
                  </div>
                  <%= if error["note_id"] do %>
                    <div>
                      <strong>Note ID:</strong>
                      <code class="ml-1">{error["note_id"]}</code>
                    </div>
                  <% end %>
                </div>
              </details>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>
    <%!-- ID Conflict Resolution Dialog --%>
    <%= if @id_conflict do %>
      <div
        id="conflict-dialog"
        class="fixed inset-0 bg-black/50 flex items-center justify-center z-50"
        phx-click="cancel_conflict"
      >
        <div
          class="bg-base-100 rounded-lg shadow-xl max-w-2xl w-full mx-4 p-6"
          phx-click="stop_propagation"
        >
          <h3 class="text-2xl font-bold mb-4 text-error">
            <span class="hero-exclamation-triangle inline-block w-6 h-6 mr-2"></span>
            Note ID Conflict Detected
          </h3>

          <div class="alert alert-warning mb-6">
            <span class="hero-information-circle w-5 h-5"></span>
            <div>
              <p class="font-semibold">The note has conflicting IDs</p>
              <p class="text-sm">
                Please choose which ID to use. The file will be updated automatically.
              </p>
            </div>
          </div>

          <div class="mb-6">
            <p class="text-sm opacity-70 mb-2">
              <strong>File:</strong>
              <code class="bg-base-200 px-2 py-1 rounded">{@id_conflict.path}</code>
            </p>
            <%= if @id_conflict.reason do %>
              <p class="text-sm opacity-70">
                <strong>Reason:</strong>
                {@id_conflict.reason}
              </p>
            <% end %>
          </div>

          <div class="space-y-3 mb-8">
            <%!-- Server ID Option --%>
            <div class="card bg-primary/10 border-2 border-primary hover:bg-primary/20 cursor-pointer transition">
              <div class="card-body p-4">
                <div class="flex items-start justify-between">
                  <div class="flex-1">
                    <div class="flex items-center gap-2 mb-2">
                      <span class="badge badge-primary">Recommended</span>
                      <h4 class="font-semibold">Server ID</h4>
                    </div>
                    <code class="text-sm block bg-base-200 px-2 py-1 rounded mb-2 font-mono">
                      {@id_conflict.server_id}
                    </code>
                    <p class="text-xs opacity-70">
                      ID found in the database at this path. This is usually the correct choice.
                    </p>
                  </div>
                  <button
                    id="choose-server-btn"
                    phx-click="resolve_conflict"
                    phx-value-choice="server"
                    class="btn btn-primary btn-sm"
                  >
                    Use This
                  </button>
                </div>
              </div>
            </div>
            <%!-- Local Cache ID Option --%>
            <%= if @id_conflict.local_id do %>
              <div class="card bg-base-200 border-2 border-base-300 hover:bg-base-300 cursor-pointer transition">
                <div class="card-body p-4">
                  <div class="flex items-start justify-between">
                    <div class="flex-1">
                      <div class="flex items-center gap-2 mb-2">
                        <span class="badge badge-neutral">Local Cache</span>
                        <h4 class="font-semibold">Browser Cache ID</h4>
                      </div>
                      <code class="text-sm block bg-base-100 px-2 py-1 rounded mb-2 font-mono">
                        {@id_conflict.local_id}
                      </code>
                      <p class="text-xs opacity-70">
                        ID stored in your browser's local cache from previous imports.
                      </p>
                    </div>
                    <button
                      id="choose-local-btn"
                      phx-click="resolve_conflict"
                      phx-value-choice="local"
                      class="btn btn-neutral btn-sm"
                    >
                      Use This
                    </button>
                  </div>
                </div>
              </div>
            <% end %>
            <%!-- JSON File ID Option --%>
            <div class="card bg-base-200 border-2 border-base-300 hover:bg-base-300 cursor-pointer transition">
              <div class="card-body p-4">
                <div class="flex items-start justify-between">
                  <div class="flex-1">
                    <div class="flex items-center gap-2 mb-2">
                      <span class="badge badge-neutral">Current File</span>
                      <h4 class="font-semibold">JSON File ID</h4>
                    </div>
                    <code class="text-sm block bg-base-100 px-2 py-1 rounded mb-2 font-mono">
                      {@id_conflict.json_id}
                    </code>
                    <p class="text-xs opacity-70">
                      ID currently in the JSON file. May contain a typo or be outdated.
                    </p>
                  </div>
                  <button
                    id="choose-json-btn"
                    phx-click="resolve_conflict"
                    phx-value-choice="json"
                    class="btn btn-neutral btn-sm"
                  >
                    Use This
                  </button>
                </div>
              </div>
            </div>
          </div>

          <div class="flex justify-end gap-3">
            <button
              id="cancel-conflict-btn"
              phx-click="cancel_conflict"
              class="btn btn-ghost"
            >
              Cancel
            </button>
          </div>
        </div>
      </div>
    <% end %>

    <div class="card bg-base-200 mb-6">
      <div class="card-body">
        <h2 class="card-title">Export Preview (Development)</h2>
        <p class="text-sm opacity-70 mb-4">
          Preview what the exported files will look like without writing to disk.
        </p>

        <div class="flex gap-4">
          <button
            id="export-preview-btn"
            phx-click="export_preview"
            phx-value-note_id="64b3b4b0-ea00-43a4-901c-cb0294b66fe1"
            class="btn btn-secondary btn-sm"
          >
            Preview Single Note
          </button>

          <button
            id="export-all-preview-btn"
            phx-click="export_all_preview"
            class="btn btn-secondary btn-sm"
          >
            Preview All Notes
          </button>
        </div>
      </div>
    </div>

    <%= if @preview_mode == :single && @preview_data do %>
      <div id="preview-container" class="space-y-6">
        <div class="card bg-base-200">
          <div class="card-body">
            <h3 class="card-title">Markdown Content (.md file)</h3>
            <pre
              id="markdown-preview"
              class="whitespace-pre-wrap font-mono text-sm bg-base-300 p-4 rounded-lg overflow-x-auto"
            >{@preview_data.markdown}</pre>
          </div>
        </div>

        <div class="card bg-base-200">
          <div class="card-body">
            <h3 class="card-title">JSON Metadata (.json file)</h3>
            <pre
              id="json-preview"
              class="whitespace-pre-wrap font-mono text-sm bg-base-300 p-4 rounded-lg overflow-x-auto"
            >{@preview_data.json}</pre>
          </div>
        </div>
      </div>
    <% end %>

    <%= if @preview_mode == :all && @preview_data do %>
      <div id="preview-container" class="space-y-6">
        <div class="alert alert-info">
          <span>Ready to export {@preview_data.count} notes</span>
        </div>

        <div :for={item <- @preview_data.items} class="card bg-base-200 mb-4">
          <div class="card-body">
            <h3 class="card-title text-lg">
              {item.note.name}
              <span class="badge badge-neutral text-xs">{item.path}</span>
            </h3>

            <div class="divider">Markdown</div>
            <pre class="whitespace-pre-wrap font-mono text-xs bg-base-300 p-3 rounded max-h-40 overflow-auto">{item.markdown}</pre>

            <div class="divider">JSON Metadata</div>
            <pre class="whitespace-pre-wrap font-mono text-xs bg-base-300 p-3 rounded max-h-40 overflow-auto">{item.json}</pre>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</Layouts.app>
